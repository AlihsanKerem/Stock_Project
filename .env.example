# ====================================================================
# BIST ALGO-TRADE & ANALİZ SİSTEMİ - ÇEVRESEL DEĞİŞKENLER (.env)
# ====================================================================

# 1. Telegram Bot Yapılandırması
# @BotFather üzerinden alınan API Token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bildirimlerin gönderileceği Telegram Kullanıcı veya Grup ID'si:
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Yapay Zeka (AI) & Otonom Ajan Yapılandırması (Pluggable Provider)
# Sağlayıcı Seçenekleri: gemini, ollama, openai_compatible, deepseek
LLM_PROVIDER=gemini

# Google AI Studio üzerinden alınan Gemini API Anahtarı:
GEMINI_API_KEY=your_gemini_api_key_here

# Model Adı (Örn: gemini-1.5-flash, gemini-1.5-pro, llama3, deepseek-chat):
LLM_MODEL=gemini-1.5-flash

# Eğer Lokal Model (Ollama / LM Studio) veya Özel Harici API kullanacaksanız:
# Ollama örneği: LLM_PROVIDER=ollama ve OLLAMA_API_URL=http://localhost:11434/api/generate
# OLLAMA_API_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3

# OpenAI-Compatible / DeepSeek / Groq örneği:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your_deepseek_or_openai_api_key_here

# 3. Sunucu ve Zamanlama Ayarları
# Flask Web Sunucusu Portu (Varsayılan: 5000):
FLASK_PORT=5000

# Günlük Otomatik BIST Tarama Saati (Format: HH:MM):
SCAN_TIME=18:30

# Fiyat/Oran Alarmlarını Kontrol Etme Sıklığı (Dakika):
ALERT_CHECK_INTERVAL_MINUTES=5
