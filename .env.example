# ====================================================================
# BIST ALGO-TRADE & ANALİZ SİSTEMİ - ÇEVRESEL DEĞİŞKENLER (.env)
# ====================================================================

# 1. Telegram Bot Yapılandırması
# @BotFather üzerinden alınan API Token:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bildirimlerin gönderileceği Telegram Kullanıcı veya Grup ID'si:
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Yapay Zeka (AI) & Otonom Ajan Yapılandırması (Pluggable Provider)
# Desteklenen Sağlayıcılar: gemini, ollama, groq, deepseek, openrouter, lmstudio, openai_compatible
LLM_PROVIDER=gemini

# A) GOOGLE GEMINI API (Varsayılan)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# B) LOKAL MODEL: OLLAMA (Ücretsiz & Sınırsız Yerel Yapay Zeka)
# LLM_PROVIDER=ollama
# OLLAMA_API_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=llama3

# C) LOKAL MODEL: LM STUDIO (OpenAI Uyumlu Yerel Arayüz)
# LLM_PROVIDER=lmstudio
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model

# D) HIZLI & ÜCRETSİZ BULUT API: GROQ
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# E) OPENROUTER (Yüzlerce model, ücretsiz kota seçenekleri)
# LLM_PROVIDER=openrouter
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=google/gemini-2.0-flash-exp:free

# F) DEEPSEEK VEYA DİĞER ÖZEL OPENAI-UYUMLU API'LER
# LLM_PROVIDER=deepseek
# LLM_API_KEY=your_deepseek_api_key_here
# LLM_MODEL=deepseek-chat

# 3. Sunucu ve Zamanlama Ayarları
# Flask Web Sunucusu Portu (Varsayılan: 5000):
FLASK_PORT=5000

# Günlük Otomatik BIST Tarama Saati (Format: HH:MM):
SCAN_TIME=18:30

# Fiyat/Oran Alarmlarını Kontrol Etme Sıklığı (Dakika):
ALERT_CHECK_INTERVAL_MINUTES=5
